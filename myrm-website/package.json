{
  "name": "myrmagent-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:3002": "next dev --turbopack -p 3002",
    "build": "bun run validate:locales && bun run validate:docs-slugs && bun run bake:release && next build",
    "bake:release": "bun run scripts/bake-desktop-release.ts",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "bun test scripts/desktop-release.test.ts scripts/deploy-paths.test.ts scripts/docs-contract.test.ts",
    "validate:locales": "bun run scripts/validate-marketing-locales.ts",
    "validate:docs-slugs": "bun run scripts/validate-docs-slugs.ts",
    "generate:hero-webm": "bun run scripts/generate-hero-demo-webm.ts"
  },
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hugeicons-react": "^0.4.0",
    "next": "16.2.4",
    "next-intl": "^4.11.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.2.21"
}
