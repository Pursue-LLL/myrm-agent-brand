# App URL (the main Myrm application)
NEXT_PUBLIC_APP_URL=https://app.myrmagent.ai

# Docs URL (Mintlify documentation site)
NEXT_PUBLIC_DOCS_URL=https://docs.myrmagent.ai

# CI / local build: set GITHUB_TOKEN so bake:release can fetch Pursue-LLL/myrm-agent Releases
# GITHUB_TOKEN=

# Deploy: push website-v* tag → GHA website-release.yml (CF_PAGES_DEPLOY_HOOK is GitHub Secret only).
# Local emergency: bun run release:website -- website-v1.2.0 (preflight + push tag; no local hook).
